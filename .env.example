# Token of the kChat bot account (Integrations → Bot accounts).
KCHAT_TOKEN=
# Secret shared with the GitHub webhook. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Read-only GitHub token: raises the API rate limit and enables "Doublon de #N" resolution (GraphQL).
# Optional for public repositories (fine-grained, public repositories read-only, is enough).
# Required for private ones: fine-grained with read-only Issues, Pull requests and Metadata.
GITHUB_TOKEN=

# Set to any value to enable debug logs.
# DEBUG=1
