# Token of the kChat bot account (Integrations → Bot accounts).
KCHAT_TOKEN=
# Secret shared with the GitHub webhook. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Optional read-only token: raises the API rate limit and enables "Doublon de #N" resolution (GraphQL).
# Fine-grained token with public repositories read-only access is enough.
GITHUB_TOKEN=

# Set to any value to enable debug logs.
# DEBUG=1
